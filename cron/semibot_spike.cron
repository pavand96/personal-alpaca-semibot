CRON_TZ=America/New_York
# Pre-market spike scanner: starts at 4:00 AM ET, exits when market opens at 9:30 AM.
# Scans every 60s for any watchlist symbol gapping >= spike_min_gap_pct vs yesterday's close.
0 4 * * 1-5 /home/pavand96/personal-alpaca-semibot/scripts/run_spike.sh premarket >> /home/pavand96/personal-alpaca-semibot/logs/spike_premarket.log 2>&1

# After-hours spike scanner: starts at 4:15 PM ET, exits at 7:45 PM ET.
# Scans every 60s for any watchlist symbol gapping >= spike_min_gap_pct vs today's 4pm close.
15 16 * * 1-5 /home/pavand96/personal-alpaca-semibot/scripts/run_spike.sh afterhours >> /home/pavand96/personal-alpaca-semibot/logs/spike_afterhours.log 2>&1

CRON_TZ=America/New_York

# ── News monitor — runs all day and night, every 15 min ──────────────────────
# Scans Alpaca news for catalyst signals (earnings, upgrades, acquisitions, …)
# Writes logs/news_signals.json — read by the spike stream at startup so it
# starts pre-warmed with overnight context. Signals expire after 20h.
*/15 * * * 1-5 /home/pavand96/personal-alpaca-semibot/.venv/bin/python /home/pavand96/personal-alpaca-semibot/main.py news-monitor >> /home/pavand96/personal-alpaca-semibot/logs/news_monitor.log 2>&1

# ── Pre-market spike stream (WebSocket, ~200ms order latency) ─────────────────
# Starts at 3:45 AM ET — 15 min before pre-market opens at 4:00 AM.
# Uses the 15 min to: load earnings calendar, load news signals, fetch
# reference closes, run startup snapshot, connect both WebSocket streams.
# By 4:00:00 AM the scanner is fully ready with zero lag on the first trade.
# Fallback launches at 6:45 AM and 8:45 AM (also 15 min early) if primary crashed.
# Lock file prevents duplicate processes.
45  3 * * 1-5 /home/pavand96/personal-alpaca-semibot/scripts/run_spike.sh premarket
45  6 * * 1-5 /home/pavand96/personal-alpaca-semibot/scripts/run_spike.sh premarket
45  8 * * 1-5 /home/pavand96/personal-alpaca-semibot/scripts/run_spike.sh premarket

# ── Regular session: adaptive-semis strategy ─────────────────────────────────
# Runs every 5 min from 9:45 AM to 4:10 PM ET.
# Bot's own require_market_open guard makes it a no-op outside NYSE hours.
# Also handles spike 1-day hold exits (live_decisions checks spike_tracker.json).
45,50,55  9 * * 1-5 /home/pavand96/personal-alpaca-semibot/scripts/run_ml_trade.sh
*/5      10 * * 1-5 /home/pavand96/personal-alpaca-semibot/scripts/run_ml_trade.sh
*/5      11 * * 1-5 /home/pavand96/personal-alpaca-semibot/scripts/run_ml_trade.sh
*/5      12 * * 1-5 /home/pavand96/personal-alpaca-semibot/scripts/run_ml_trade.sh
*/5      13 * * 1-5 /home/pavand96/personal-alpaca-semibot/scripts/run_ml_trade.sh
*/5      14 * * 1-5 /home/pavand96/personal-alpaca-semibot/scripts/run_ml_trade.sh
*/5      15 * * 1-5 /home/pavand96/personal-alpaca-semibot/scripts/run_ml_trade.sh
0,5,10   16 * * 1-5 /home/pavand96/personal-alpaca-semibot/scripts/run_ml_trade.sh

# ── After-hours spike stream (WebSocket) ─────────────────────────────────────
# Starts at 4:15 PM ET. Streams vs today's locked 4pm close.
# Self-exits at 7:45 PM (before Alpaca's 8pm extended-hours cutoff).
15 16 * * 1-5 /home/pavand96/personal-alpaca-semibot/scripts/run_spike.sh afterhours
